# Virtual environments
.venv/
venv/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# Local Wiz credentials / config (never commit credentials)
wiz_config.json

# Local runtime cache
last_results.json
last_results.json.gz
mttr_history.json

# Durable scan archive + vulnerability ledger (SQLite + raw scan JSON).
# Anchored to the repo root so it does NOT also ignore the wiz_dashboard/data source
# package (the bare `data/` rule did, silently hiding demo.py / ledger.py).
/data/

# Local tooling scratch (Playwright MCP snapshots/screenshots/console logs)
.playwright-mcp/

# Local GAS dev harness build output (gas/dev/serve.mjs writes it per page load)
gas/dev/server.dev.js

# Local GAS AI dev harness build output (gas_ai/dev/serve.mjs writes it per page load)
gas_ai/dev/server.dev.js

# Same, for the DevSecOps register.
gas_devsecops/dev/server.dev.js

# Same, for the hub. Listed here with its three siblings rather than in gas_hub/.gitignore:
# one rule for four identical artifacts is easier to keep true than four, and this is where a
# reader already looks for it.
gas_hub/dev/server.dev.js

# Local Spark/Delta test debris: brick/tests spins up a real SparkSession, which writes a
# metastore and a warehouse directory into the working directory.
spark-warehouse/
metastore_db/
derby.log
# Local Wiz credentials for the gas_ai dev harness (dev/serve.mjs reads gas_ai/.env.local
# and gas_ai/dev/.env.local). Unanchored, so a copy in any directory is covered: a
# credential file one level from where it was expected must not become a commit.
.env.local

# Agent-tooling state that installs into the repo root. `npx skills add` writes .agents/
# (the skill bodies), a .claude/skills/ symlink farm pointing back at them, and a lockfile;
# .claude also collects a per-developer permission allowlist and a runtime lock. None of it
# is this project's source.
#
# Listed one by one rather than as a bare `.claude/`, for the same reason the /data/ rule
# above is anchored: a broad rule here would silently hide a shared .claude/settings.json,
# .claude/agents/ or .claude/commands/ that a teammate later adds, and this file has been
# bitten by exactly that once already.
.agents/
.claude/skills/
.claude/settings.local.json
.claude/scheduled_tasks.lock
skills-lock.json

# Generated HTML review surfaces (lavish-axi serves these from a local express server).
.lavish/

# design-sync (claude.ai/design)
.ds-sync/
ds-bundle/
# The WHOLE tree, not the curated subset this used to list (.cache/, learnings/,
# node_modules, adapter/dist/). It is local tooling: the adapter reads gas_ai's stylesheets
# and REGENERATES its own outputs, so the tracked copies were a snapshot that drifted from
# whatever the last run produced — `shared-extras.css` and the generated `docs/` churned on
# every run and had to be kept out of every unrelated commit by hand. The 150 files it
# tracked were untracked in the same commit that added this line; they remain on disk.
.design-sync/

# Installed dependencies at the repo ROOT. Each GAS package already ignores its own
# node_modules/; the root never did, which is how one vitest cache file
# (node_modules/.vite/vitest/*/results.json) got committed and then showed up dirty after
# every single test run. Untracked in the same commit that added this line.
node_modules/
