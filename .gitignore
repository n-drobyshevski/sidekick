# Virtual environments
.venv/
venv/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# Streamlit secrets / local config (never commit credentials)
.streamlit/secrets.toml
wiz_config.json

# Local runtime cache
last_results.json
last_results.json.gz
mttr_history.json

# Durable scan archive + vulnerability ledger (SQLite + raw scan JSON).
# Anchored to the repo root so it does NOT also ignore the wiz_dashboard/data source
# package (the bare `data/` rule did, silently hiding demo.py / ledger.py).
/data/

# Local tooling scratch (Playwright MCP snapshots/screenshots/console logs)
.playwright-mcp/

# Local GAS dev harness build output (gas/dev/serve.mjs writes it per page load)
gas/dev/server.dev.js

# Local GAS AI dev harness build output (gas_ai/dev/serve.mjs writes it per page load)
gas_ai/dev/server.dev.js

# Local Spark/Delta test debris: brick/tests spins up a real SparkSession, which writes a
# metastore and a warehouse directory into the working directory.
spark-warehouse/
metastore_db/
derby.log
# Local Wiz credentials for the gas_ai dev harness (dev/serve.mjs reads gas_ai/.env.local
# and gas_ai/dev/.env.local). Unanchored, so a copy in any directory is covered: a
# credential file one level from where it was expected must not become a commit.
.env.local
