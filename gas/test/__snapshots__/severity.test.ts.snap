// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`normalizeSeverity (fixture parity) > "   " -> UNKNOWN 1`] = `"UNKNOWN"`;

exports[`normalizeSeverity (fixture parity) > " high " -> HIGH 1`] = `"HIGH"`;

exports[`normalizeSeverity (fixture parity) > "" -> UNKNOWN 1`] = `"UNKNOWN"`;

exports[`normalizeSeverity (fixture parity) > "CRITICAL" -> CRITICAL 1`] = `"CRITICAL"`;

exports[`normalizeSeverity (fixture parity) > "HIGHER" -> UNKNOWN 1`] = `"UNKNOWN"`;

exports[`normalizeSeverity (fixture parity) > "INFORMATIONAL" -> INFO 1`] = `"INFO"`;

exports[`normalizeSeverity (fixture parity) > "Info" -> INFO 1`] = `"INFO"`;

exports[`normalizeSeverity (fixture parity) > "LOW" -> LOW 1`] = `"LOW"`;

exports[`normalizeSeverity (fixture parity) > "MEDIUM" -> MEDIUM 1`] = `"MEDIUM"`;

exports[`normalizeSeverity (fixture parity) > "UNKNOWN" -> UNKNOWN 1`] = `"UNKNOWN"`;

exports[`normalizeSeverity (fixture parity) > "bogus" -> UNKNOWN 1`] = `"UNKNOWN"`;

exports[`normalizeSeverity (fixture parity) > "critical" -> CRITICAL 1`] = `"CRITICAL"`;

exports[`normalizeSeverity (fixture parity) > "critical\\n" -> CRITICAL 1`] = `"CRITICAL"`;

exports[`normalizeSeverity (fixture parity) > "informational" -> INFO 1`] = `"INFO"`;

exports[`normalizeSeverity (fixture parity) > 42 -> UNKNOWN 1`] = `"UNKNOWN"`;

exports[`normalizeSeverity (fixture parity) > null -> UNKNOWN 1`] = `"UNKNOWN"`;
