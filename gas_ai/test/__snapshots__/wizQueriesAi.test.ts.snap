// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`query documents > Q_AGENT_EXPANSION is unchanged 1`] = `
"query SidekickAiAgentExpansion($quick: Boolean, $first: Int, $after: String, $query: GraphEntityQueryInput, $projectId: String) {
  graphSearch(
    quick: $quick
    first: $first
    after: $after
    query: $query
    projectId: $projectId
  ) {
    pageInfo { hasNextPage endCursor }
    nodes {
      entities {
        id
        name
        type
        properties
      }
    }
  }
}
"
`;

